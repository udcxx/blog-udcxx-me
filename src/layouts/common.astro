---
//
// 全ページに読み込まれるファイル
// 
 
import '../assets/reset.css';
const { pageTitle = '', pageDescription = '' } = Astro.props;


// 定数
const siteName = '無趣味の戯言';
const siteUrl = 'https://blog.udcxx.me/';
const siteDescription = '無趣味なりにつらつらと戯言を。フロントエンドと車にちょっぴり興味あり。';

// 各 meta の値
const title = pageTitle == '' ? siteName : `${pageTitle} | ${siteName}`;
const description = pageDescription == '' ? siteDescription : pageDescription;

const host = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const pageUrl = host + path;

const ogType = Astro.url.pathname.includes('article') ? 'article' : 'website';

const ogImage = siteUrl + 'blog-card.png';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />

<link rel="icon" href="/favicon.ico" />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={siteName} />
<meta name="twitter:card" content="summary_large_image" />
    
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;700&family=Ubuntu:wght@300;500&display=swap" rel="stylesheet">



<style lang="scss">
:root {
    // Color
    --black: #1E1E1E;
    --dark-green: #071E22;
    --gray: #D1D5D5;
    --orange: #D98F36;
    --dark-orange: #ad6106;
}


html {
    font-size: 16px;
    font-family: "IBM Plex Sans JP", sans-serif;
    color: var(--black);
    background-color: var(--dark-green);
}

body {
    position: relative;
}

</style>