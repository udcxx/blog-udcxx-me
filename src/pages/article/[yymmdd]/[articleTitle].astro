---
import { getCollection, render } from "astro:content";
import Common from '../../../layouts/common.astro';
import ArticleCard from '../../../layouts/article-card.astro';
import Header from '../../../layouts/site-header.astro';
import Footer from '../../../layouts/site-footer.astro'

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((post) => {
        const [yymmdd, articleTitle] = post.id.split("/");

        return {
            params: { yymmdd, articleTitle },
            props: { post },
        };
    });
}

const { post } = Astro.props;
const { Content } = await render(post);

const displayDate = () => {
    const d = new Date(post.data.date);
    return `${ d.getFullYear() }-${ d.getMonth() < 9 ? '0' + (d.getMonth() + 1) : d.getMonth() + 1 }-${ d.getDate() < 10 ? '0' + d.getDate() : d.getDate() }`
}

// 関連記事
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const recentPosts = sortedPosts.filter((p) => p.id !== post.id).slice(0, 4);

const primaryTag = post.data.tags[0];
const relatedPosts = primaryTag
    ? sortedPosts
          .filter((p) => p.id !== post.id && p.data.tags.includes(primaryTag))
          .slice(0, 4)
    : [];
---

<html lang="ja">
    <head>
        <Common
            pageTitle = {post.data.title}
            pageDescription = {post.data.description}
        />
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1301045842322864" crossorigin="anonymous"></script>
    </head>

    <body>
        <Header />
        <main>
            <section class="article_head">
                <span class="article_head--emoji">
                    {post.data.eyecatchEmoji ? post.data.eyecatchEmoji : "📝"}
                </span>
                <h1>{post.data.title}</h1>
            </section>
            <!-- head -->

            <section class="article_body">
                <article class="article">
                    {post.data.eyecatch && <img src={`/${post.data.eyecatch}`} />}
                    <Content />

                    <a href="https://www.buymeacoffee.com/udcxx" target="_blank" class="buymeacoffee"><img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me A Coffee" style="height:60px !important;width:217px !important;"></a>

                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-1301045842322864"
                         data-ad-slot="2499763349"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <ins class="adsbygoogle second"
                        style="display:block"
                        data-ad-client="ca-pub-1301045842322864"
                        data-ad-slot="2499763349"
                        data-ad-format="auto"
                        data-full-width-responsive="true"></ins>
                </article>
                <div class="side">
                    <div class="details box">
                        <span class="details--head">公開日</span>
                        <time datetime={`${displayDate}`}>{displayDate}</time>
                        <span class="details--head">タグ</span>
                        <div class="details--tags">
                            {post.data.tags.map((tag) => (
                                <a href={`/tags/${tag}/1/`}>{tag}</a>
                            ))}
                        </div>
                    </div><!-- /details -->

                    <div class="box sharebutton">
                        <a href="" class="share_x">
                            <svg width="29" height="30" viewBox="0 0 29 30" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_2011_714)"><path class="fill_x" d="M17.2589 12.6964L28.0548 0H25.4966L16.1225 11.0241L8.63543 0H0L11.3219 16.6704L0 29.9846H2.55843L12.4577 18.3427L20.3646 29.9846H29L17.2583 12.6964H17.2589ZM13.7548 16.8173L12.6077 15.1573L3.48027 1.94852H7.40986L14.7758 12.6084L15.9229 14.2684L25.4978 28.1247H21.5682L13.7548 16.8179V16.8173Z"/></g><defs><clipPath id="clip0_2011_714"><rect width="29" height="30" fill="white"/></clipPath></defs></svg>
                            <span>ポストする</span>
                        </a>
                    </div><!-- /Share X -->

                    <div class="box sharebutton">
                        <a href="" class="share_hatebu">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="30" height="30" viewBox="0 0 355.004 300"><g><path class="fill_b" d="M280.009,0h70v200.005h-70V0z"></path><path class="fill_b" d="M215.192,160.596c-11.844-13.239-28.314-20.683-49.443-22.288 c18.795-5.122,32.443-12.616,41.077-22.628c8.593-9.88,12.856-23.292,12.856-40.171c0-13.362-2.922-25.184-8.579-35.397 c-5.805-10.152-14.14-18.276-25.102-24.357c-9.586-5.274-20.98-8.994-34.262-11.188c-13.349-2.126-36.709-3.198-70.231-3.198H0 V298.63h83.976c33.737,0,58.064-1.182,72.94-3.441c14.863-2.337,27.334-6.27,37.428-11.662 c12.484-6.587,22.007-15.964,28.662-28.01c6.698-12.085,10.014-26.02,10.014-41.956 C233.017,191.514,227.079,173.798,215.192,160.596z M75.26,67.27h17.398c20.108,0,33.617,2.267,40.59,6.787 c6.877,4.542,10.388,12.38,10.388,23.547c0,10.745-3.733,18.313-11.118,22.751c-7.483,4.354-21.117,6.562-41.079,6.562H75.26 V67.27z M144.276,237.733c-7.916,4.862-21.557,7.251-40.696,7.251H75.265v-64.949h29.54c19.654,0,33.243,2.475,40.469,7.414 c7.343,4.942,10.955,13.665,10.955,26.191C156.226,224.85,152.263,232.899,144.276,237.733z"></path><path class="fill_b" d="M315.014,220.003c-22.101,0-40.002,17.891-40.002,39.991 c0,22.1,17.902,40.006,40.002,40.006c22.072,0,39.99-17.906,39.99-40.006C355.004,237.894,337.088,220.003,315.014,220.003z"></path></g></svg>
                            <span>はてブで共有する</span>
                        </a>
                    </div><!-- /Share Hatebu! -->

                    <div class="box sharebutton">
                        <a href="" class="share_line">
