                            <span>LINEで送る</span>
                        </a>
                    </div><!-- /Share LINE -->

                    <div class="box sharebutton">
                        <a href="" class="share_copy">
                            <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 512 512"><path d="M358.2 105h95.7c3.7 0 6.5-2.8 6.5-6.5 0-8.4-3.7-16.7-10.2-22.3L367.5 8.4C361.9 3.8 352.6 1 345.2 1c-4.6 0-7.4 3.7-7.4 7.4v77.1c0 11.1 9.3 19.5 20.4 19.5"/><path d="M309.9 85.5V0H170.5c-18.6 0-34.4 14.9-34.4 34.4v357.7c0 18.6 14.9 34.4 34.4 34.4H426c18.6 0 34.4-15.8 34.4-34.4V132.9H358.2c-26 0-48.3-21.4-48.3-47.4"/><path d="M107.3 421.9V68.8H86c-18.6 0-34.4 14.9-34.4 34.4v374.5c0 18.6 14.9 34.4 34.4 34.4h272.3c18.6 0 34.4-15.8 34.4-34.4v-21.4h-251c-19.5-1-34.4-15.8-34.4-34.4"/></svg>
                            <span>URLをコピーする</span>
                        </a>
                    </div><!-- /Share Copy URL -->

                    <div class="box sharebutton">
                        <a href="" class="share_markdown">
                            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><g><path d="M27.8344 5.77051H2.16563C0.970313 5.77051 0 6.74082 0 7.93145V22.0643C0 23.2596 0.970313 24.2299 2.16563 24.2299H27.8391C29.0344 24.2299 30.0047 23.2596 30 22.0689V7.93145C30 6.74082 29.0297 5.77051 27.8344 5.77051ZM15.8672 19.9033H12.9844V14.2783L10.1016 17.883L7.21875 14.2783V19.9033H4.32656V10.0971H7.20938L10.0922 13.7018L12.975 10.0971H15.8578V19.9033H15.8672ZM22.2094 20.0486L17.8828 15.0002H20.7656V10.0971H23.6484V15.0002H26.5312L22.2094 20.0486Z" fill="#071E22"/></g></svg>
                            <span>リンクをコピーする</span>
                        </a>
                    </div><!-- /Share Markdown -->
                </div>
            </section>

            <section class="new_articles other_posts">
                <h2 class="tag_title">New</h2>

                <div class="cards">
                    {recentPosts.map((post) => (
                        <ArticleCard 
                              title={post.data.title}
                              date={post.data.date}
                              tags={post.data.tags}
                              eyecatch={post.data.eyecatch}
                              eyecatchEmoji={post.data.eyecatchEmoji}
                              link={post.id}
                        />
                    ))}
                </div>

                <a href="/tags/new/1/" class="more">More New Posts... &Gt;</a>
            </section>

            <section class="sametag_articles other_posts">
                <h2 class="tag_title">{primaryTag ? primaryTag : ""}</h2>

                <div class="cards">
                    {relatedPosts.map((post) => (
                        <ArticleCard 
                              title={post.data.title}
                              date={post.data.date}
                              tags={post.data.tags}
                              eyecatch={post.data.eyecatch}
                              eyecatchEmoji={post.data.eyecatchEmoji}
                              link={post.id}
                        />
                    ))}
                </div>

                <a href={`/tags/${primaryTag}/1/`} class="more">More {primaryTag} Posts... &Gt;</a>
            </section>
        </main>

        <Footer />
    </body>
</html>

<style lang="scss" is:global>

.article_head {
    padding: 150px 0 50px;
    text-align: center;

    &--emoji {
        font-size: 80px;
        text-align: center;
    }

    h1 {
        margin-top: 50px;
        font-size: 30px; font-weight: 400;
        color: var(--gray);
    }
}

.article_body {
    margin: 0 auto;
    width: 100%; max-width: 1024px;
    padding: 0 12px;
    display: flex;
    justify-content: space-between; align-items: flex-start;

    @media (max-width: 1024px) {
        flex-wrap: wrap;
    }

    .article {
        width: 74.2%;
        padding: 15px;
        flex-shrink: 1;
        background-color: var(--gray);
        border-radius: 10px;

        @media (max-width: 1024px) {
            width: 100%;
        }

        .buymeacoffee {
            margin: 24px auto 16px;
            display: block;
        }
    }

    .side {
        width: 24%;
        position: sticky;
        top: 15px;

        @media (max-width: 1024px) {
            margin-top: 16px;
            width: 100%;
            display: flex;
            justify-content: space-between; flex-wrap: wrap;
        }

        .box {
            margin-bottom: 16px;
            padding: 15px;
            background-color: var(--gray);
            border-radius: 10px;
        }

        .details {
            width: 100%;
            
            span {
                display: block;
            }

            &--head {
                margin-bottom: 16px;
                font-size: 18px; font-weight: 700;
            }

            time {
                margin: 16px 0 16px auto;
                font-size: 18px; font-weight: 400;
                text-align: right;
                display: block;
            }

            &--tags {
                font-size: 18px; font-weight: 400;
                color: var(--orange);
                display: flex;
                justify-content: flex-end; gap: 10px;

                a:hover {
                    opacity: 0.5;
                }
            }
        }

        .sharebutton {
            padding: 0;
            
            a {
                padding: 15px;
                display: flex;
                justify-content: flex-start; align-items: center;
                gap: 16px;

                &:hover {
                    span {
                        color: var(--orange);
                    }

                    svg {
                        opacity: 1;
                    }
                    
                    .fill_x { fill: #FFFFFF }
                    .fill_b { fill: #00a4de }
                    .fill_li_1 { fill: #00c300; }
                    .fill_li_2 { fill: #ffffff; }
                    .fill_url { fill: #FFFFFF; }
                    .fill_md { fill: #FFFFFF; }
                }
            }

            svg {
                width: 30px; height: 30px;
                fill: var(--dark-green);
                opacity: 0.5;
            }

            span {
                @media (max-width: 1024px) {
                    display: none;
                }
            }
        }
    }
}

.other_posts {
    margin: 100px auto 0;
    max-width: 1012px;
    
    .tag_title {
        margin-bottom: -10px;
        font-size: 80px; font-weight: 500; font-family: 'ubuntu', sans-serif;
        line-height: 1em;
        color: var(--gray);
        opacity: 0.5;
    }
    
    .cards {
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    
        @media (max-width: 1012px) {
            grid-template-columns: 1fr;
        }
    }
    
    .more {
        margin-top: 40px;
        font-size: 20px; font-weight: 500; font-family: 'ubuntu', sans-serif;
        letter-spacing: 0.01em;
        text-align: right;
        color: var(--orange);
        display: block;
    
        &:hover {
            opacity: 0.5;
        }
    }
}

#toast-message {
    // トースト用
    width: fit-content;
    padding: 15px 30px 10px;
    margin: 0 auto;
    position: fixed;
    bottom: 10%; left: 0; right: 0; z-index: 200;
    font-size: 14px;
    color: #FFF;
    background-color: var(--orange);
    border-radius: 10px;
}

// 
// 本文向けのスタイル
// 

article {
    h2 {
        margin: 64px auto 32px;
        padding-bottom: 10px;
        font-size: 24px; font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        position: relative;
    
        &::after {
            content: '';
            margin: 0 auto;
            width: 3em; height: 3px;
            display: block;
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background-color: var(--orange);
            border-radius: 25%;
        }
    }
    
    h3 {
        margin: 40px 0;
        padding-left: 10px;
        font-size: 18px; font-weight: 700;
        line-height: 1.2em;
        text-align: left;
        position: relative;
    
        &::after {
            content: '';
            margin: 0 auto;
            width: 3px; height: calc(100% + 15px);
            display: block;
            position: absolute;
            top: 50%; left: 0;
            transform: translateY(-50%);
            background-color: var(--orange);
            border-radius: 25%; 
        }
    }
    
    h4 {
        margin: 24px 0;
        font-size: 18px; font-weight: 700;
        line-height: 1.2em;
        text-align: left;
    }
    
    h5, h6 {
        margin: 22px 0;
        font-size: 16px; font-weight: 700;
        line-height: 1.2em;
        text-align: left;
    }
    
    p {
        margin-bottom: 16px;
        font-size: 16px; font-weight: 400;
        line-height: 1.5em;
        text-align: left;
    
        strong {
            font-weight: 700;
        }
    
        code {
            padding: 3px 5px;
            font-size: 14px;
            color: var(--gray);
            border-radius: 5px;
            background-color: var(--black);
        }

        &:last-child {
            margin-bottom: 0;
        }
    }
    
    pre {
        margin: 16px 0;
        padding: 10px;
        overflow-x: scroll;
        border-radius: 5px;
    }
    
    table {
        max-width: 100%;
        overflow-x: scroll;
    
        th {
            padding: 12px 16px;
            font-weight: 700;
            border-bottom: 2px solid var(--black);
        }
        td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--black);
        }
    }
    
    img {
        margin: 16px auto;
        width: auto; max-width: 100%;
        display: block;
    }
    
    hr {
        margin: 32px auto;
        width: 66px;
        border-top: 3px solid var(--orange);
        border-radius: 25%;
    }
    
    a {
        color: var(--dark-orange);
    
        &:hover {
            opacity: 0.5;
        }
    }

    ul {
        margin-bottom: 32px;
        padding-left: 2em;
        
        li {
            margin-bottom: 8px;
            list-style: disc;
            line-height: 1.5em;
        }

        ul {
            margin-bottom: 0;
            margin-top: 8px;
        }
    }

    blockquote {
        margin: 16px 0 16px 4px;
        padding: 8px 0 8px 10px;
        border-left: 3px solid var(--orange);
        box-sizing: border-box;
    }

    ins.adsbygoogle {
        max-width: 100%;
        margin: 40px auto;
        display: block;
        position: relative;
        background-color: transparent;
    
        &[data-ad-status="filled"]::before {
            content: '【広告】';
            position: absolute;
            top: -1.2em; left: 0;
            font-size: 12px; font-weight: 400;
            letter-spacing: 0.2em;
            color: #888;
        }
    
        &[data-ad-status="unfilled"] {
            display: none !important;
        }
    }
}
</style>

<script>
    const showToast = (message = '✅️ コピーしました') => {
        document.getElementById('toast-message')?.remove();

        const toast = document.createElement('div');
        toast.id = 'toast-message';
        toast.textContent = message;

        document.body.appendChild(toast);

        requestAnimationFrame(() => {
            toast.style.opacity = '1';
        });
    
        // 2秒後にフェードアウトしてDOMから削除
        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }, 2000);
    }

    document.addEventListener('DOMContentLoaded', () => {
        /**
         * Google Adsense
         */
        const heads = document.querySelectorAll('.post-content h2');
        const targetAd = document.querySelector('.adsbygoogle.second');

        if (heads.length >= 2 && targetAd) {
            document.querySelector('.article')?.insertBefore(targetAd, heads[1]);
        } else if (targetAd) {
            (targetAd as HTMLElement).style.display = 'none';
        }

        ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
      
        /**
         * シェアリンク生成
         */
        const title = encodeURIComponent(document.title);
        const url = encodeURIComponent(location.href);
          
        document.querySelector('.share_x')?.setAttribute('href', `https://x.com/intent/tweet?url=${url}&text=${title}`);
        document.querySelector('.share_hatebu')?.setAttribute('href', `http://b.hatena.ne.jp/add?mode=confirm&amp;url=${url}}&amp;title=${title}`);
        document.querySelector('.share_line')?.setAttribute('href', `https://social-plugins.line.me/lineit/share?url=${url}`);

        document.querySelector('.share_copy')?.addEventListener('click', async (e) => {
            e.preventDefault();
            try {
                await navigator.clipboard.writeText(`${location.href}`);
                showToast('✅️ URLをコピーしました');
            } catch (err) {
                console.error('クリップボードへのコピーに失敗しました:', err);
            }
        });

        document.querySelector('.share_markdown')?.addEventListener('click', async (e) => {
            e.preventDefault();
            try {
                await navigator.clipboard.writeText(`[${document.title}](${location.href})`);
                showToast('✅️ Markdown形式でリンクをコピーしました');
            } catch (err) {
                console.error('クリップボードへのコピーに失敗しました:', err);
            }
        });
    });
</script>